cmake_minimum_required(VERSION 3.20)

if(NOT EXISTS "${AURORA_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "Aurora source tree is missing: ${AURORA_DIR}")
endif()

# Keep the Linux package manifest independent of the checkout path.
file(GLOB _entries RELATIVE "${AURORA_DIR}" "${AURORA_DIR}/*")
list(REMOVE_ITEM _entries ".git" "extern" "build")
set(_files "")
foreach(_entry IN LISTS _entries)
    if(IS_SYMLINK "${AURORA_DIR}/${_entry}")
        continue()
    elseif(IS_DIRECTORY "${AURORA_DIR}/${_entry}")
        file(GLOB_RECURSE _children LIST_DIRECTORIES false RELATIVE "${AURORA_DIR}" "${AURORA_DIR}/${_entry}/*")
        list(APPEND _files ${_children})
    else()
        list(APPEND _files "${_entry}")
    endif()
endforeach()
list(FILTER _files EXCLUDE REGEX "(^|/)\\.git(/|$)")
list(SORT _files)
set(_manifest "")
foreach(_file IN LISTS _files)
    if(NOT IS_SYMLINK "${AURORA_DIR}/${_file}")
        file(SHA256 "${AURORA_DIR}/${_file}" _hash)
        string(APPEND _manifest "${_file} ${_hash}\n")
    endif()
endforeach()
string(SHA256 _fingerprint "${_manifest}")

if(DEFINED PROVENANCE_FILE)
    file(READ "${PROVENANCE_FILE}" _provenance)
    string(JSON _recorded ERROR_VARIABLE _error GET "${_provenance}" AuroraSourceFingerprint)
    if(_error OR NOT _recorded STREQUAL _fingerprint)
        message(FATAL_ERROR "Native prebuilt package does not match the Aurora sources. Regenerate it with Prepare-NativePrebuilt.sh or omit --native-prebuilt-dir.")
    endif()
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_fingerprint}" COMMAND_ERROR_IS_FATAL ANY)
endif()
