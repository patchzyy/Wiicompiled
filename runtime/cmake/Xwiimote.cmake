option(MKW_ENABLE_XWIIMOTE "Linux kernel-managed Gen 1 Wii Remote backend" OFF)
if(MKW_ENABLE_XWIIMOTE)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "MKW_ENABLE_XWIIMOTE requires Linux")
    endif()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(MKW_XWIIMOTE REQUIRED IMPORTED_TARGET libxwiimote>=2)
    add_library(mkw_xwiimote INTERFACE)
    add_library(mkw::xwiimote ALIAS mkw_xwiimote)
    target_compile_definitions(mkw_xwiimote INTERFACE MKW_ENABLE_XWIIMOTE=1)
    target_link_libraries(mkw_xwiimote INTERFACE PkgConfig::MKW_XWIIMOTE)
endif()
