if(NOT DEFINED SEH_SOURCE)
    message(FATAL_ERROR "SEH_SOURCE is required")
endif()
file(READ "${SEH_SOURCE}" source)
string(FIND "${source}" "LONG CALLBACK SehLogger(EXCEPTION_POINTERS* info)" begin)
string(FIND "${source}" "LONG WINAPI UnhandledSehFilter" end)
if(begin LESS 0 OR end LESS begin)
    message(FATAL_ERROR "Cannot locate the production first-chance handler")
endif()
math(EXPR length "${end} - ${begin}")
string(SUBSTRING "${source}" ${begin} ${length} handler)
string(FIND "${handler}" "GuestFlat::HandleAccessViolation(" guest)
string(FIND "${handler}" "ExceptionCode == kCppExceptionCodeGcc" gcc)
string(FIND "${handler}" "ExceptionCode == kCppExceptionCodeMsvc" msvc)
string(FIND "${handler}" "ExceptionCode & 0x20000000u" customer)
string(FIND "${handler}" "if (g_suppressSehReporting && g_sehJumpTarget)" recovery)
string(FIND "${handler}" "longjmp(" jump)
string(FIND "${handler}" "return ReportFatalSehAndExit(info);" fatal)
if(guest LESS 0 OR gcc LESS guest OR msvc LESS gcc OR customer LESS msvc OR
   recovery LESS customer OR jump LESS recovery OR fatal LESS jump)
    message(FATAL_ERROR "First-chance software exceptions must pass through after GuestFlat and before constructor recovery")
endif()
math(EXPR filterLength "${recovery} - ${gcc}")
string(SUBSTRING "${handler}" ${gcc} ${filterLength} filter)
string(FIND "${filter}" "return EXCEPTION_CONTINUE_SEARCH;" passthrough)
if(passthrough LESS 0)
    message(FATAL_ERROR "Software exceptions do not return to their frame handlers")
endif()
